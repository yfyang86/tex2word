<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" default-locale="en-US">
  <info><title>Test Numeric</title><id>tex2word-test-numeric</id>
    <updated>2020-01-01T00:00:00+00:00</updated></info>
  <citation collapse="citation-number"><layout prefix="[" suffix="]" delimiter=", ">
    <text variable="citation-number"/></layout></citation>
  <bibliography><layout>
    <text variable="citation-number" prefix="[" suffix="] "/>
    <names variable="author" suffix=", "><name/></names>
    <text variable="title" suffix=". "/>
    <date variable="issued"><date-part name="year"/></date>
  </layout></bibliography>
</style>
